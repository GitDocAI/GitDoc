# Token the CLI uses to publish. Generate one:  openssl rand -hex 24
PUBLISH_TOKEN=
# Host port (the container always listens on 8080).
PORT=8080

# --- Search -----------------------------------------------------------------
# By default pages are searched with a built-in index: nothing to run.
#
# To use OpenSearch instead, start the bundled one:
#   COMPOSE_PROFILES=opensearch
#   OPENSEARCH_URL=http://opensearch:9200
# or point at your own cluster (OPENSEARCH_USERNAME / OPENSEARCH_PASSWORD,
# OPENSEARCH_INSECURE=true for a self-signed certificate).
#
# Semantic search (OpenSearch only): any OpenAI-compatible embeddings API,
# e.g. Ollama at http://host.docker.internal:11434/v1
#   EMBEDDINGS_URL=
#   EMBEDDINGS_MODEL=text-embedding-3-small
#   EMBEDDINGS_API_KEY=
