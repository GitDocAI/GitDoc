# Token the CLI uses to publish. Generate one:  openssl rand -hex 24
PUBLISH_TOKEN=
# Host port (the container always listens on 8080).
PORT=8080

# --- AI (optional) ----------------------------------------------------------
# Any OpenAI-compatible endpoint. ThreatWinds, for instance:
#   AI_URL=https://apis.threatwinds.com/api/ai/v1
#   AI_API_KEY=...        AI_API_SECRET=...     (sent as api-key / api-secret)
# OpenAI or Ollama use only AI_API_KEY (Bearer), e.g. AI_URL=http://host.docker.internal:11434/v1
#
# AI_EMBEDDING_MODEL  vectors for the search box (finds meaning, not only words)
# AI_CHAT_MODEL       the assistant: answers readers' questions from the docs
AI_URL=
AI_API_KEY=
AI_API_SECRET=
AI_EMBEDDING_MODEL=
AI_CHAT_MODEL=

# --- Search ------------------------------------------------------------------
# Nothing to set: a built-in index (BM25, plus vectors when AI_EMBEDDING_MODEL is
# set) is used. To use OpenSearch, uncomment the service in docker-compose.yml
# and set:
#   OPENSEARCH_URL=http://opensearch:9200
# (OPENSEARCH_USERNAME / OPENSEARCH_PASSWORD / OPENSEARCH_INSECURE for your own cluster.)

# --- Limits (defaults shown) --------------------------------------------------
# RATE_SEARCH_PER_MIN=120   per visitor
# RATE_ASK_PER_MIN=10       per visitor
# ASK_DAILY_LIMIT=1000      questions per documentation per day (0 = no cap)
# TRUST_PROXY=true          behind a proxy/CDN, so limits count real visitors
#
# --- Analytics (off by default) ----------------------------------------------
# EVENTS=file               page views, searches and questions → DATA_DIR/_events/
# EVENTS_URL=               or POST each event as JSON (EVENTS_TOKEN = Bearer)
