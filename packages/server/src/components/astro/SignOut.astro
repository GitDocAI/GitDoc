---
/**
 * Sign-out control for private documentation. Rendered only when the reader
 * has a session. It is a POST form, not a link: the site prefetches links as
 * they scroll into view, and prefetching a sign-out link would sign the reader
 * out by itself. `data-astro-reload` makes it a full page load: the client
 * router would otherwise submit it with fetch() and splice the login page (a
 * standalone document) into the current one.
 */
interface Props {
  /** icon: a round icon button (navbar); row: a labelled row (menus, sidebar). */
  variant?: 'icon' | 'row'
  /** Who is signed in, shown as a tooltip. */
  who?: string
}
const { variant = 'icon', who } = Astro.props
const title = who ? `Sign out (${who})` : 'Sign out'
---

<form method="post" action="/api/auth/logout" data-sign-out data-astro-reload class:list={[variant === 'row' && 'w-full']}>
  <button
    type="submit"
    aria-label="Sign out"
    title={title}
    class:list={[
      'rounded-lg text-foreground/70 hover:text-foreground hover:bg-muted transition-colors cursor-pointer',
      variant === 'row'
        ? 'flex items-center gap-2 w-full px-3 py-2 text-sm'
        : 'grid place-items-center w-8 h-8 p-1',
    ]}
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
      <path d="m16 17 5-5-5-5" />
      <path d="M21 12H9" />
    </svg>
    {variant === 'row' && <span>Sign out</span>}
  </button>
</form>
