---
/**
 * Right-cluster item renderer — shared by the navbar's inline desktop
 * layout AND the mobile kebab dropdown. Iterates over the preset's
 * `rightClusterOrder` and emits the matching markup for each entry
 * (search pill, navbar CTA links, theme toggle).
 *
 * The `variant` prop tweaks dimensions so the same items read well as
 * a horizontal row (`inline`) or as a stacked menu (`stacked`).
 */
import type { RightClusterItem } from '../../lib/presets'

interface NavbarLink {
  url: string
  label?: string
  icon?: string
  style?: 'default' | 'primary' | 'subtle' | string
}
interface Props {
  /** Order + which items to render. Lets the mobile kebab override
   *  the preset's `rightClusterOrder` so it can always show every
   *  item regardless of which preset is active. */
  items: RightClusterItem[]
  navbarLinks: NavbarLink[]
  hasBothModes: boolean
  assistantEnabled: boolean
  variant: 'inline' | 'stacked'
}
const { items, navbarLinks, hasBothModes, assistantEnabled, variant } = Astro.props

/* Same icon map / helper as StaticHeader. Duplicated locally (small)
   so this component is self-contained and doesn't need a shared
   import surface. */
const NAVBAR_ICONS: Record<string, string> = {
  github:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.4.5 0 5.9 0 12.5c0 5.3 3.4 9.7 8.2 11.3.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.2-.8.1-.8.1-.8 1.3.1 2 1.3 2 1.3 1.1 2 3 1.4 3.8 1.1.1-.8.5-1.4.8-1.7-2.7-.3-5.5-1.3-5.5-6 0-1.3.5-2.4 1.3-3.3-.1-.3-.6-1.6.1-3.3 0 0 1-.3 3.3 1.3 1-.3 2-.4 3-.4s2 .1 3 .4c2.3-1.6 3.3-1.3 3.3-1.3.7 1.7.2 3 .1 3.3.8.9 1.3 2 1.3 3.3 0 4.7-2.8 5.7-5.5 6 .5.4.8 1.1.8 2.3v3.3c0 .3.2.7.8.6C20.6 22.2 24 17.8 24 12.5 24 5.9 18.6.5 12 .5z"/></svg>',
  youtube:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2c-.3-1-1-1.8-2-2C19.6 3.7 12 3.7 12 3.7s-7.6 0-9.5.5c-1 .2-1.7 1-2 2C0 8.1 0 12 0 12s0 3.9.5 5.8c.3 1 1 1.8 2 2C4.4 20.3 12 20.3 12 20.3s7.6 0 9.5-.5c1-.2 1.7-1 2-2C24 15.9 24 12 24 12s0-3.9-.5-5.8zM9.6 15.6V8.4l6.3 3.6-6.3 3.6z"/></svg>',
  linkedin:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.4 20.4h-3.6v-5.6c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9v5.7H9.4V8.9h3.4v1.6h.1c.5-.9 1.6-1.8 3.3-1.8 3.6 0 4.2 2.4 4.2 5.4v6.3zM5.3 7.3c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm1.8 13.1H3.5V8.9h3.6v11.5zM22.2 0H1.8C.8 0 0 .8 0 1.7v20.6c0 1 .8 1.7 1.8 1.7h20.5c1 0 1.8-.8 1.8-1.7V1.7C24 .8 23.2 0 22.2 0z"/></svg>',
  twitter:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/></svg>',
  x: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/></svg>',
  discord:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.075.075 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.74 19.74 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.058a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>',
  mail:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>',
  external:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"/><path d="m10 14 11-11"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>',
}
function iconSvg(name: string | undefined): string {
  if (!name) return ''
  return NAVBAR_ICONS[name] ?? NAVBAR_ICONS['external']
}
function isExternal(url: string): boolean {
  return /^https?:\/\//i.test(url) || url.startsWith('mailto:')
}

const stacked = variant === 'stacked'
---

{items.map((item) => (
  item === 'search' ? (
    <Fragment>
      <button
        type="button"
        data-search-trigger
        aria-label="Search documentation"
        title="Search documentation (⌘K)"
        class:list={[
          'group flex items-center gap-2 rounded-lg bg-foreground/5 hover:bg-foreground/10 text-muted-foreground hover:text-foreground transition-colors text-sm cursor-pointer',
          stacked
            ? 'w-full pl-3 pr-1.5 py-2'
            : 'pl-3 pr-1.5 py-1.5 min-w-[180px]',
        ]}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0">
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.3-4.3" />
        </svg>
        <span class="flex-1 text-left">Search...</span>
        <kbd class="inline-flex items-center justify-center text-[11px] font-medium opacity-70 px-1.5 py-0.5 rounded border border-foreground/15 transition-colors font-sans">⌘K</kbd>
      </button>
      {assistantEnabled && (
        <button
          type="button"
          data-ask-ai
          aria-label="Ask AI (⌥I)"
          title="Ask AI (⌥I)"
          class:list={[
            'group flex items-center gap-2 rounded-lg bg-foreground/5 hover:bg-foreground/10 text-foreground transition-colors text-sm cursor-pointer',
            stacked
              ? 'w-full pl-3 pr-1.5 py-2'
              : 'pl-3 pr-1.5 py-1.5',
          ]}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 text-primary">
            <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z" />
            <path d="M5 3v4" />
            <path d="M3 5h4" />
            <path d="M19 17v4" />
            <path d="M17 19h4" />
          </svg>
          <span class={stacked ? 'flex-1 text-left' : ''}>Ask AI</span>
          <kbd class="inline-flex items-center justify-center text-[11px] font-medium opacity-70 px-1.5 py-0.5 rounded border border-foreground/15 transition-colors font-sans">⌥I</kbd>
        </button>
      )}
    </Fragment>
  ) : item === 'links' ? (
    <Fragment>
      {navbarLinks.map((link) => {
        const style = link.style ?? 'default'
        const external = isExternal(link.url)
        const svg = iconSvg(link.icon)
        const target = external ? '_blank' : undefined
        const rel = external ? 'noopener noreferrer' : undefined
        let variantStyle: string | undefined
        let variantClasses = ''
        /* Stacked variant (mobile kebab dropdown) ignores the link's
           `style` and renders every CTA with neutral text — no
           primary fills, no subtle outlines. Reads as a plain menu. */
        if (stacked) {
          variantClasses = 'text-foreground/80 hover:text-foreground hover:bg-foreground/6'
        } else if (style === 'primary') {
          variantStyle = 'background-color: var(--primary); color: var(--primary-foreground);'
          variantClasses = 'hover:opacity-90'
        } else if (style === 'subtle') {
          variantStyle =
            'background-color: color-mix(in srgb, var(--primary) 15%, transparent); ' +
            'color: var(--primary); ' +
            'border: 1px solid color-mix(in srgb, var(--primary) 40%, transparent);'
          variantClasses = 'hover:bg-primary/25'
        } else {
          variantClasses = 'text-foreground/70 hover:text-foreground hover:bg-muted'
        }
        return (
          <a
            href={link.url}
            target={target}
            rel={rel}
            class:list={[
              'flex items-center gap-2 px-3 py-1.5 rounded-lg text-sm font-medium transition-colors no-underline',
              stacked ? 'w-full justify-start' : '',
              variantClasses,
            ]}
            style={variantStyle}
          >
            {svg && (
              <span class="inline-flex items-center justify-center" style="width:18px;height:18px" set:html={svg} />
            )}
            {link.label && <span>{link.label}</span>}
          </a>
        )
      })}
    </Fragment>
  ) : item === 'theme' && hasBothModes !== false ? (
    <button
      type="button"
      data-theme-toggle
      aria-label="Toggle theme"
      title="Toggle light/dark mode"
      class:list={[
        'rounded-lg text-foreground/70 hover:text-foreground hover:bg-muted transition-colors cursor-pointer',
        stacked
          ? 'flex items-center gap-2 w-full px-3 py-2 text-sm'
          : 'grid place-items-center w-8 h-8 p-1',
      ]}
    >
      <span class={stacked ? 'grid place-items-center w-5 h-5' : 'contents'}>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="theme-icon-sun" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2" />
          <path d="M12 20v2" />
          <path d="m4.93 4.93 1.41 1.41" />
          <path d="m17.66 17.66 1.41 1.41" />
          <path d="M2 12h2" />
          <path d="M20 12h2" />
          <path d="m6.34 17.66-1.41 1.41" />
          <path d="m19.07 4.93-1.41 1.41" />
        </svg>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="theme-icon-moon" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
        </svg>
      </span>
      {stacked && <span class="flex-1 text-left">Toggle theme</span>}
    </button>
  ) : null
))}
