---
/**
 * Knowledge Base landing — visual parity with publish-web's `KBView`.
 * Three sections inside a 1000px container:
 *   1. Hero: pulsing-dot badge + large title + description.
 *   2. Search: card-wrapped real input with a Sparkles icon-box on
 *      the left and an accent submit button on the right. Suggestion
 *      chips render below.
 *   3. Optional categories grid and popular-articles grid, each with
 *      an "eyebrow" label + horizontal line header.
 *
 * AI-Ask wiring (search submit, follow-up chat) is layered on later
 * as a hydration island — the markup is static-friendly today and
 * uses `data-search-trigger` hooks so the island can attach.
 */
interface SectionTab {
  id: string
  title: string
  href: string
  icon?: string
  slug: string
}

interface PopularArticle {
  id: string
  title: string
  href: string
  excerpt?: string
}

interface Props {
  name?: string
  heroTitle?: string
  heroDescription?: string
  heroPlaceholder?: string
  searchSuggestions?: string[]
  showCategories?: boolean
  showPopularArticles?: boolean
  popularTitle?: string
  popularArticles?: PopularArticle[]
  sections?: SectionTab[]
      entriesById?: Record<string, { title: string; href: string }>
  /** The version the visitor is currently reading. Sent with every
   *  Ask AI question so RAG search stays pinned to this version's
   *  content instead of searching across every version of the doc. */
  activeVersionId?: string
}

const {
  name = 'Help Center',
  heroTitle = 'How can we help?',
  heroDescription,
  heroPlaceholder = 'Ask a question...',
  searchSuggestions = [],
  showCategories = false,
  showPopularArticles = false,
  popularTitle = 'Popular Articles',
  popularArticles = [],
  sections = [],
      entriesById = {},
  activeVersionId,
} = Astro.props

import { HEROICONS } from '../../lib/heroicons.generated'

/* Section icons — same Lucide-path map as StaticHeader so the
   category cards match the navbar tab icons. Trimmed to the
   shapes most used by sections; falls back to a folder for
   anything not in the map. */
const SECTION_ICONS: Record<string, string> = {
  'book-open':
    '<path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>',
  book: '<path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>',
  'file-text':
    '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/>',
  code: '<path d="m16 18 6-6-6-6"/><path d="m8 6-6 6 6 6"/>',
  blocks:
    '<rect width="7" height="7" x="14" y="3" rx="1"/><path d="M10 21V8a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-5a1 1 0 0 0-1-1H3"/>',
  settings:
    '<path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2"/><circle cx="12" cy="12" r="3"/>',
}

function sectionIconHtml(icon: string | undefined): string {
  if (!icon) return `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${SECTION_ICONS['book-open']}</svg>`
  const trimmed = icon.trim()
  // Material Icons render via font ligature (name as text), not a per-name
  // class — see iconLibrary.ts. `<i class="mi-foo">` showed nothing.
  if (trimmed.startsWith('mi-')) {
    const ligature = trimmed.slice(3).replace(/[^a-z0-9_ ]/gi, '')
    return `<span class="material-icons" style="font-size:24px;line-height:1" aria-hidden="true">${ligature}</span>`
  }
  // Heroicons ship as static SVG (no font) — see iconLibrary.ts / gen-heroicons.cjs.
  if (trimmed.startsWith('hi-')) {
    const svg = HEROICONS[trimmed]
    return svg ? svg.replace('<svg ', '<svg width="24" height="24" ') : ''
  }
  if (/^(pi pi-|fa fa-)/.test(trimmed)) {
    return `<i class="${trimmed}" style="font-size:24px;line-height:1"></i>`
  }
  const path = SECTION_ICONS[trimmed] ?? SECTION_ICONS['book-open']
  return `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${path}</svg>`
}

/* Card accent palette — same rotation publish-web uses on the
   category icon backgrounds (primary, blue, purple). */
const CARD_COLORS = ['var(--primary)', '#3b82f6', '#8b5cf6']
---

<div class="kb-landing relative" data-kb-root data-kb-version-id={activeVersionId} style="background: var(--background); color: var(--foreground); font-family: var(--font-sans);">
  <div class="kb-container">
    {/* Hero */}
    <div class="kb-hero">
      <div class="kb-badge">
        <span class="kb-badge-dot" aria-hidden="true"></span>
        {name}
      </div>

      <h1 class="kb-title">{heroTitle}</h1>

      {heroDescription && (
        <p class="kb-description">{heroDescription}</p>
      )}

      {/* Search card */}
      <div class="kb-search-wrap">
        <form class="kb-search" data-kb-search action="/" method="get">
          <div class="kb-search-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.582a.5.5 0 0 1 0 .962L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/>
              <path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/>
            </svg>
          </div>
          <input
            type="text"
            name="q"
            class="kb-search-input"
            placeholder={heroPlaceholder}
            autocomplete="off"
            data-kb-search-input
          />
          <button type="submit" class="kb-search-submit" aria-label="Search">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
            </svg>
          </button>
        </form>

        {searchSuggestions.length > 0 && (
          <div class="kb-suggestions">
            {searchSuggestions.map((q) => (
              <button
                type="button"
                class="kb-chip"
                data-kb-suggestion={q}
              >
                {q}
              </button>
            ))}
          </div>
        )}
      </div>
    </div>

    {/* Categories */}
    {showCategories && sections.length > 0 && (
      <section class="kb-section">
        <div class="kb-eyebrow">
          <span>Browse by Category</span>
          <div class="kb-eyebrow-line" />
        </div>
        <div class="kb-categories">
          {sections.map((s, index) => (
            <a href={s.href} class="kb-category" style={`--card-accent: ${CARD_COLORS[index % CARD_COLORS.length]}`}>
              <div class="kb-category-icon">
                <Fragment set:html={sectionIconHtml(s.icon)} />
              </div>
              <h3 class="kb-category-title">{s.title}</h3>
              <span class="kb-category-cta">
                Explore
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                </svg>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    {/* Popular articles */}
    {showPopularArticles && popularArticles.length > 0 && (
      <section class="kb-section">
        <div class="kb-eyebrow">
          <span>{popularTitle}</span>
          <div class="kb-eyebrow-line" />
        </div>
        <div class="kb-popular">
          {popularArticles.map((a) => (
            <a href={a.href} class="kb-popular-row">
              <div class="kb-popular-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/>
                  <path d="M14 2v4a2 2 0 0 0 2 2h4"/>
                </svg>
              </div>
              <div class="kb-popular-text">
                <div class="kb-popular-title">{a.title}</div>
                {a.excerpt && (
                  <div class="kb-popular-excerpt">{a.excerpt}</div>
                )}
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="kb-popular-arrow">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>

  {/* Chat surface — hidden until the first question, then it takes over the
      KB landing (toggled via [data-chat-active] on .kb-landing). */}
  <div class="kb-chat" data-kb-chat>
    <div class="kb-chat__head">
      <button type="button" class="kb-chat__back" data-kb-chat-exit aria-label={`Back to ${name}`}>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>
        </svg>
        <span>{name}</span>
      </button>
    </div>

    <div class="kb-chat__thread" data-kb-answers></div>

    <form class="kb-chat__composer" data-kb-chat-form>
      <span class="kb-chat__composer-icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.582a.5.5 0 0 1 0 .962L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/>
        </svg>
      </span>
      <input type="text" class="kb-chat__composer-input" placeholder={heroPlaceholder} autocomplete="off" data-kb-chat-input />
      <button type="submit" class="kb-chat__send" aria-label="Send">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="m5 12 7-7 7 7"/><path d="M12 19V5"/>
        </svg>
      </button>
    </form>
  </div>
</div>

{/* Section id → href, so answer "Sources" can deep-link back into the docs. */}
<script type="application/json" data-kb-sections set:html={JSON.stringify(
  sections.map((s) => ({ id: s.id, href: s.href, title: s.title })),
).replace(/</g, '\\u003c')} />

    {/* Entry id → href, so answer "Sources" can deep-link to the specific article. */}
    <script type="application/json" data-kb-entries set:html={JSON.stringify(
      entriesById,
    ).replace(/</g, '\\u003c')} />

<script>
  /* KB ask: the hero search (and suggestion chips) ask the documentation
     assistant and render the answer in-page as a growing Q&A thread, with
     follow-up turns carrying prior context. Markdown rendering is shared with
     the side-panel via window.GitDocAIMarkdown (/md.js). Re-runs on view
     transitions (`astro:page-load`); a per-form flag prevents double-binding. */
  function initKbAsk() {
    const root = document.querySelector<HTMLElement>('[data-kb-root]')
    const heroForm = document.querySelector<HTMLFormElement>('[data-kb-search]')
    const heroInput = document.querySelector<HTMLInputElement>('[data-kb-search-input]')
    const chatForm = document.querySelector<HTMLFormElement>('[data-kb-chat-form]')
    const chatInput = document.querySelector<HTMLInputElement>('[data-kb-chat-input]')
    const thread = document.querySelector<HTMLElement>('[data-kb-answers]')
    const exitBtn = document.querySelector<HTMLButtonElement>('[data-kb-chat-exit]')
    if (!root || !heroForm || !heroInput || !chatForm || !chatInput || !thread) return
    if (root.dataset.kbWired === 'true') return
    root.dataset.kbWired = 'true'

    const sectionsById: Record<string, { href: string; title: string }> = {}
    try {
      const el = document.querySelector('[data-kb-sections]')
      if (el && el.textContent) {
        for (const s of JSON.parse(el.textContent)) sectionsById[s.id] = s
      }
    } catch {}

    const entriesById: Record<string, { href: string; title: string }> = {}
    try {
      const el = document.querySelector('[data-kb-entries]')
      if (el && el.textContent) {
        Object.assign(entriesById, JSON.parse(el.textContent))
      }
    } catch {}

    const md = () => (window as any).GitDocAIMarkdown
    const escapeHtml = (s: string) =>
      md() ? md().escapeHtml(s) : s.replace(/[&<>"']/g, (c: string) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as Record<string, string>)[c])
    const renderAnswer = (t: string) =>
      md() ? md().render(t) : `<p>${escapeHtml(t).replace(/\n/g, '<br>')}</p>`

    const COPY_ICON =
      '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>'

    const conversation: Array<{ role: string; content: string }> = []

    function activateChat() {
      root!.setAttribute('data-chat-active', 'true')
      setTimeout(() => chatInput!.focus(), 60)
    }
    function exitChat() {
      root!.setAttribute('data-chat-active', 'false')
      setTimeout(() => heroInput!.focus(), 60)
    }

    // User as a right-aligned pill, AI as plain prose + a Copy chip — same
    // markup the side-panel uses, so it inherits those global styles and the
    // panel's document-level copy handler works here too.
    function appendTurn(question: string): HTMLElement {
      const user = document.createElement('div')
      user.className = 'assistant-msg assistant-msg--user'
      user.textContent = question
      thread!.appendChild(user)

      const ai = document.createElement('div')
      ai.className = 'assistant-msg assistant-msg--ai'
      ai.innerHTML =
        '<div class="assistant-msg__body assistant-thinking" aria-live="polite" aria-label="Thinking">' +
        '<span class="thinking-dot"></span><span class="thinking-dot"></span><span class="thinking-dot"></span>' +
        '</div>'
      thread!.appendChild(ai)
      thread!.scrollTop = thread!.scrollHeight
      return ai
    }

    function fillAnswer(ai: HTMLElement, text: string, sources?: Array<{ title?: string; section_id?: string; entry_id?: string }>) {
      const body = ai.querySelector('.assistant-msg__body') as HTMLElement
      body.classList.remove('assistant-thinking')
      body.innerHTML = renderAnswer(text)

      const actions = document.createElement('div')
      actions.className = 'assistant-msg__actions'
      actions.innerHTML =
        '<button type="button" class="assistant-msg__action" data-msg-copy aria-label="Copy reply" title="Copy reply"><span class="assistant-msg__action-icon">' +
        COPY_ICON +
        '</span><span class="assistant-msg__action-label">Copy</span></button>'
      const copyBtn = actions.querySelector('[data-msg-copy]')
      if (copyBtn) copyBtn.setAttribute('data-msg-text', text)
      ai.appendChild(actions)

      if (sources && sources.length) {
        const seen = new Set<string>()
        const chips: string[] = []
        for (const s of sources) {
          const key = s.title || s.entry_id || ''
          if (!key || seen.has(key)) continue
          seen.add(key)
          // Prefer entry-level deep-link; fall back to section-level
          const entry = s.entry_id ? entriesById[s.entry_id] : undefined
          const sec = entry ? undefined : (s.section_id ? sectionsById[s.section_id] : undefined)
          const href = entry?.href ?? sec?.href
          const label = escapeHtml(s.title || 'Source')
          chips.push(href ? `<a class="kb-source" href="${href}">${label}</a>` : `<span class="kb-source">${label}</span>`)
        }
        if (chips.length) {
          const wrap = document.createElement('div')
          wrap.className = 'kb-sources'
          wrap.innerHTML = '<span class="kb-sources-label">Sources</span>' + chips.join('')
          ai.appendChild(wrap)
        }
      }
      ;(window as any).__gitdocaiRenderMermaid?.()
      thread!.scrollTop = thread!.scrollHeight
    }

    async function ask(text: string) {
      const q = (text || '').trim()
      if (q.length < 3) return
      activateChat()
      const ai = appendTurn(q)
      const history = conversation.slice(-8)
      /* Read live (not cached at load) — see AssistantPanel's assistant-
         panel.js for why. Pins RAG search to the version the visitor is
         actually reading instead of searching across the whole doc. */
      const versionId = root!.getAttribute('data-kb-version-id') || undefined
      try {
        const res = await fetch('/api/ask', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ question: q, history, version_id: versionId }),
        })
        const data: any = await res.json().catch(() => ({}))
        if (!res.ok) {
          fillAnswer(ai, data.error || 'Sorry, I could not answer that right now.')
          return
        }
        const answer = data.answer || 'No answer was returned.'
        fillAnswer(ai, answer, data.sources)
        conversation.push({ role: 'user', content: q })
        conversation.push({ role: 'assistant', content: answer })
      } catch {
        fillAnswer(ai, 'Network error. Please try again.')
      }
    }

    heroForm.addEventListener('submit', (e) => {
      e.preventDefault()
      const v = heroInput!.value
      heroInput!.value = ''
      ask(v)
    })
    chatForm.addEventListener('submit', (e) => {
      e.preventDefault()
      const v = chatInput!.value
      chatInput!.value = ''
      ask(v)
    })
    if (exitBtn) exitBtn.addEventListener('click', () => exitChat())
    document.querySelectorAll<HTMLButtonElement>('[data-kb-suggestion]').forEach((btn) => {
      btn.addEventListener('click', () => ask(btn.dataset.kbSuggestion ?? ''))
    })
  }
  initKbAsk()
  document.addEventListener('astro:page-load', initKbAsk)
</script>

<style>
  /* Scoped vars — translate publish-web's `${textColor}NN` overlay
     trick into srgb mixes so the surface tints adapt to either
     theme automatically. */
  .kb-landing {
    --kb-bg-card: color-mix(in srgb, var(--foreground) 4%, transparent);
    --kb-bg-elevated: color-mix(in srgb, var(--foreground) 8%, transparent);
    --kb-border-dim: color-mix(in srgb, var(--foreground) 8%, transparent);
    --kb-border-subtle: color-mix(in srgb, var(--foreground) 12%, transparent);
    --kb-border-medium: color-mix(in srgb, var(--foreground) 18%, transparent);
    --kb-text-secondary: color-mix(in srgb, var(--foreground) 70%, var(--background) 30%);
    --kb-text-dim: color-mix(in srgb, var(--foreground) 50%, var(--background) 50%);
    --kb-text-muted: color-mix(in srgb, var(--foreground) 35%, var(--background) 65%);
    --kb-accent-dim: color-mix(in srgb, var(--primary) 15%, transparent);
  }

  .kb-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 40px clamp(16px, 5vw, 48px) 60px;
    animation: kb-fade-up 0.5s ease-out;
  }

  @keyframes kb-fade-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ---- Hero ---- */
  .kb-hero {
    text-align: center;
    padding: 60px 0 40px;
  }

  .kb-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: var(--kb-accent-dim);
    border: 1px solid color-mix(in srgb, var(--primary) 25%, transparent);
    border-radius: 24px;
    font-size: 12px;
    font-weight: 600;
    color: var(--primary);
    margin-bottom: 28px;
  }
  .kb-badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--primary);
    animation: kb-pulse 2s ease-in-out infinite;
  }
  @keyframes kb-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .kb-title {
    font-size: clamp(28px, 7vw, 48px);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--foreground);
    margin: 0 0 20px;
  }
  .kb-description {
    font-size: 18px;
    line-height: 1.5;
    color: var(--kb-text-secondary);
    max-width: 560px;
    margin: 0 auto 20px;
  }

  /* ---- Search ---- */
  .kb-search-wrap {
    max-width: 640px;
    margin: 40px auto 0;
  }
  .kb-search {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--kb-bg-card);
    border: 1px solid var(--kb-border-subtle);
    border-radius: 20px;
    padding: 8px;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .kb-search:focus-within {
    border-color: var(--primary);
    box-shadow: 0 0 0 4px var(--kb-accent-dim);
  }
  .kb-search-icon {
    width: 52px;
    height: 52px;
