---
/**
 * Static-friendly header for the SSG build.
 *
 * Mirrors the visual of @gitdocai/ui DocHeader but uses real <a href>
 * links so navigation works without JS. The React component is built
 * around onClick handlers that only fire after hydration — fine in the
 * dashboard, useless in a static site.
 */
import type { Preset } from '../../lib/presets'
import { iconHtml } from '../../lib/iconLibrary'
import RightClusterItems from './RightClusterItems.astro'
import VersionSelector from './VersionSelector.astro'

interface NavItem {
  id: string
  title: string
  href: string
  icon?: string
}

/** A configured navbar link from the manifest (config.navbar[]). */
interface NavbarLink {
  label?: string
  url: string
  /** "default" (text only), "primary" (filled accent), "subtle" (outlined). */
  style?: 'default' | 'primary' | 'subtle' | string
  /** Icon key — accepts the curated 55-icon library configured in the
   *  dashboard (github, twitter, discord, mail, etc.). */
  icon?: string
}

interface Props {
  docName: string
  navItems: NavItem[]
  activeId: string
  /** Per-mode logo URLs. Both rendered side-by-side; CSS hides one
   *  based on `html.dark`, so the theme toggle swaps the logo without
   *  a reload. */
  logoDarkUrl?: string
  logoLightUrl?: string
  /** Intrinsic logo pixel size (from the manifest). Emitted as the
   *  <img width/height> so the logo's box is reserved before load. */
  logoDarkWidth?: number
  logoDarkHeight?: number
  logoLightWidth?: number
  logoLightHeight?: number
  /** When false, hide the doc name next to the logo (theme.show_name). */
  showName?: boolean
  /** Configured CTA links rendered on the right side (config.navbar). */
  navbarLinks?: NavbarLink[]
  /** Whether the doc supports both light + dark modes (theme.modes
   *  contains both). When false we hide the theme toggle. */
  hasBothModes?: boolean
  /** Resolved preset — drives the right-cluster ordering. */
  preset: Preset
  /** When true, an "Ask AI" pill renders next to the search button. */
  assistantEnabled?: boolean
  /** Title chain to the current page (parent groups + page title).
   *  Rendered on mobile in the subbar as "Group › Page". */
  breadcrumb?: string[]
  /** When the manifest enables the version selector, these drive the
   *  dropdown shown either after the logo or in the right cluster
   *  (depending on `versionSelectorPosition`). */
  versionSelectorEnabled?: boolean
  versionSelectorPosition?: 'navbar_right' | 'after_logo'
  versions?: Array<{ id: string; name: string; slug: string; is_latest?: boolean; is_default?: boolean; is_deprecated?: boolean }>
  activeVersionId?: string
  activeVersionName?: string
}
const {
  docName,
  navItems,
  activeId,
  logoDarkUrl,
  logoLightUrl,
  logoDarkWidth,
  logoDarkHeight,
  logoLightWidth,
  logoLightHeight,
  showName = true,
  navbarLinks = [],
  hasBothModes = true,
  preset,
  assistantEnabled = false,
  breadcrumb = [],
  versionSelectorEnabled = false,
  versionSelectorPosition = 'navbar_right',
  versions = [],
  activeVersionId = '',
  activeVersionName = '',
} = Astro.props
const showVersionSelector = versionSelectorEnabled && versions.length > 0

/* If only one logo is provided, use it for both modes — better than
   falling back to the initial-letter avatar when at least one logo
   exists. */
const darkLogo = logoDarkUrl ?? logoLightUrl
const lightLogo = logoLightUrl ?? logoDarkUrl
/* Dims follow the same fallback as the URL so a single-logo doc still
   reserves the right box. Undefined when unknown → attr is omitted. */
const darkLogoW = logoDarkWidth ?? logoLightWidth
const darkLogoH = logoDarkHeight ?? logoLightHeight
const lightLogoW = logoLightWidth ?? logoDarkWidth
const lightLogoH = logoLightHeight ?? logoDarkHeight
const hasAnyLogo = Boolean(darkLogo || lightLogo)
const initial = docName[0]?.toUpperCase() ?? 'D'

/**
 * Map of icon keys → simple SVG inline. Mirrors the curated icon set
 * the dashboard exposes. Falls back to a generic "external link" icon
 * for unknown keys so the button still has a visual cue.
 */
const NAVBAR_ICONS: Record<string, string> = {
  github:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.4.5 0 5.9 0 12.5c0 5.3 3.4 9.7 8.2 11.3.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.2-.8.1-.8.1-.8 1.3.1 2 1.3 2 1.3 1.1 2 3 1.4 3.8 1.1.1-.8.5-1.4.8-1.7-2.7-.3-5.5-1.3-5.5-6 0-1.3.5-2.4 1.3-3.3-.1-.3-.6-1.6.1-3.3 0 0 1-.3 3.3 1.3 1-.3 2-.4 3-.4s2 .1 3 .4c2.3-1.6 3.3-1.3 3.3-1.3.7 1.7.2 3 .1 3.3.8.9 1.3 2 1.3 3.3 0 4.7-2.8 5.7-5.5 6 .5.4.8 1.1.8 2.3v3.3c0 .3.2.7.8.6C20.6 22.2 24 17.8 24 12.5 24 5.9 18.6.5 12 .5z"/></svg>',
  youtube:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2c-.3-1-1-1.8-2-2C19.6 3.7 12 3.7 12 3.7s-7.6 0-9.5.5c-1 .2-1.7 1-2 2C0 8.1 0 12 0 12s0 3.9.5 5.8c.3 1 1 1.8 2 2C4.4 20.3 12 20.3 12 20.3s7.6 0 9.5-.5c1-.2 1.7-1 2-2C24 15.9 24 12 24 12s0-3.9-.5-5.8zM9.6 15.6V8.4l6.3 3.6-6.3 3.6z"/></svg>',
  linkedin:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.4 20.4h-3.6v-5.6c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9v5.7H9.4V8.9h3.4v1.6h.1c.5-.9 1.6-1.8 3.3-1.8 3.6 0 4.2 2.4 4.2 5.4v6.3zM5.3 7.3c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm1.8 13.1H3.5V8.9h3.6v11.5zM22.2 0H1.8C.8 0 0 .8 0 1.7v20.6c0 1 .8 1.7 1.8 1.7h20.5c1 0 1.8-.8 1.8-1.7V1.7C24 .8 23.2 0 22.2 0z"/></svg>',
  twitter:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/></svg>',
  x: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/></svg>',
  discord:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.075.075 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.74 19.74 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.058a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>',
  mail:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>',
  external:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"/><path d="m10 14 11-11"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>',
}
function navbarIconSvg(icon: string | undefined): string {
  if (!icon) return ''
  return NAVBAR_ICONS[icon] ?? ''
}
function isExternal(url: string): boolean {
  return /^https?:\/\//i.test(url) || url.startsWith('mailto:')
}

/* Section-tab icons: sections render no icon unless one is configured.
   Sole exception — the "Agent" section (first kb page) falls back to
   a sparkles glyph so it always has a visual cue. */
function sectionIconHtml(name: string | undefined, title?: string): string {
  const resolved = iconHtml(name, 16)
  if (resolved) return resolved
  if (title === 'Agent') return iconHtml('hi-sparkles-outline', 16)
  return ''
}

---

{/* Inline snippets — Astro doesn't have inline component definitions,
    but using `<Fragment>` + the `Astro.slots`-like pattern is overkill
    for this. Each "slot" renders identically wherever it's placed, so
    we just bind the markup to a JSX expression and re-use it in
    different zones below. */}
{/* eslint-disable astro/no-set-html-directive */}

<header
  class="border-b shrink-0 relative text-foreground"
  style="border-bottom-color: var(--chrome-border); font-family: inherit"
>
<div
  data-header-grid
  class:list={[
    'grid items-center h-16 px-4 lg:px-6',
    'grid-cols-[1fr_auto_1fr]',
    preset.arrangement === 'centered' ? 'max-w-[1440px] mx-auto' : '',
  ]}
>
  {/* LEFT — logo + (preset-specific sections, desktop only). The
      hamburger lives in the mobile subbar below, not here. */}
  <div data-header-left class="flex items-center gap-2 min-w-0 justify-self-start col-start-1">
    <a
      href="/"
      class="flex items-center gap-3 no-underline text-foreground"
    >
      {
        hasAnyLogo ? (
          <>
            {darkLogo && (
              <img
                src={darkLogo}
                alt={docName ? `${docName} logo` : 'Logo'}
                width={darkLogoW}
                height={darkLogoH}
                class="logo-dark h-8 w-auto max-w-[180px] object-contain"
                loading="eager"
                transition:persist="logo-dark"
              />
            )}
            {lightLogo && (
              <img
                src={lightLogo}
                alt={docName ? `${docName} logo` : 'Logo'}
                width={lightLogoW}
                height={lightLogoH}
                class="logo-light h-8 w-auto max-w-[180px] object-contain"
                loading="eager"
                transition:persist="logo-light"
              />
            )}
          </>
        ) : (
          <div class="w-8 h-8 rounded-lg flex items-center justify-center bg-primary">
            <span class="text-sm font-bold text-primary-foreground">{initial}</span>
          </div>
        )
      }
      {showName !== false && (
        <span class="font-bold text-[17px] tracking-tight">{docName}</span>
      )}
    </a>

    {showVersionSelector && versionSelectorPosition === 'after_logo' && (
      <div class="hidden lg:flex items-center ml-2">
        <VersionSelector
          versions={versions}
          activeVersionId={activeVersionId}
          activeVersionName={activeVersionName}
        />
      </div>
    )}

    {preset.header.sectionsPlacement === 'navbar_left' && (
      <nav data-header-inline-nav class="hidden lg:flex items-center gap-1 ml-8 whitespace-nowrap">
        {navItems.map((item) => {
          const isActive = item.id === activeId
          const iconHtml = sectionIconHtml(item.icon, item.title)
          return (
            <a
              href={item.href}
              class:list={[
                'group flex items-center text-[13px] font-medium rounded-lg px-3.5 py-2 gap-1.5 transition-colors no-underline',
                isActive
                  ? 'bg-foreground/8 text-foreground'
                  : 'text-foreground/70 hover:bg-foreground/6 hover:text-foreground',
              ]}
            >
              {iconHtml && (
                <span
                  class="inline-flex items-center justify-center shrink-0 opacity-90"
                  style="width:16px;height:16px"
                  set:html={iconHtml}
                />
              )}
              <span>{item.title}</span>
            </a>
          )
        })}
      </nav>
    )}
  </div>

  {/* CENTER — only populated when the preset sets `searchInCenter`
      (Mist). Otherwise stays empty so the grid's auto-column collapses
      to 0 and LEFT/RIGHT split the row evenly via the 1fr tracks. */}
  <div data-header-center class="hidden lg:flex items-center gap-3 justify-self-center col-start-2">
    {preset.header.sectionsPlacement === 'navbar_center' && (
      <nav data-header-inline-nav class="flex items-center gap-1">
        {navItems.map((item) => {
          const isActive = item.id === activeId
          const iconHtml = sectionIconHtml(item.icon, item.title)
          return (
            <a
              href={item.href}
              class:list={[
                'group flex items-center text-[13px] font-medium rounded-lg px-3.5 py-2 gap-1.5 transition-colors no-underline',
                isActive
                  ? 'bg-foreground/8 text-foreground'
                  : 'text-foreground/70 hover:bg-foreground/6 hover:text-foreground',
              ]}
            >
              {iconHtml && (
                <span
                  class="inline-flex items-center justify-center shrink-0 opacity-90"
                  style="width:16px;height:16px"
                  set:html={iconHtml}
                />
              )}
              <span>{item.title}</span>
            </a>
          )
        })}
      </nav>
    )}
    {preset.header.searchInCenter && (
      <Fragment>
        <button
          type="button"
          data-search-trigger
          aria-label="Search documentation"
          title="Search documentation (⌘K)"
          class="group flex items-center gap-2 pl-3.5 pr-1.5 py-2 rounded-lg bg-foreground/5 hover:bg-foreground/10 text-muted-foreground hover:text-foreground transition-colors text-sm min-w-[320px] cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0">
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.3-4.3" />
          </svg>
          <span class="flex-1 text-left">Search...</span>
          <kbd class="inline-flex items-center justify-center text-[11px] font-medium opacity-70 px-1.5 py-0.5 rounded border border-foreground/15 transition-colors font-sans">⌘K</kbd>
        </button>
        {assistantEnabled && (
          <button
            type="button"
            data-ask-ai
            aria-label="Ask AI (⌥I)"
            title="Ask AI (⌥I)"
            class="group flex items-center gap-2 pl-3.5 pr-1.5 py-2 rounded-lg bg-foreground/5 hover:bg-foreground/10 text-foreground transition-colors text-sm cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 text-primary">
              <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z" />
              <path d="M5 3v4" />
              <path d="M3 5h4" />
              <path d="M19 17v4" />
              <path d="M17 19h4" />
            </svg>
            <span>Ask AI</span>
            <kbd class="inline-flex items-center justify-center text-[11px] font-medium opacity-70 px-1.5 py-0.5 rounded border border-foreground/15 transition-colors font-sans">⌥I</kbd>
          </button>
        )}
      </Fragment>
    )}
  </div>

  {/* RIGHT — preset-specific order on desktop; mobile (below md)
      collapses everything into a kebab dropdown so the layout reads
      the same regardless of preset. */}
  <div data-header-right class="justify-self-end relative col-start-3">
  <div class="hidden lg:flex items-center gap-3">
    {showVersionSelector && versionSelectorPosition === 'navbar_right' && (
      <VersionSelector
        versions={versions}
        activeVersionId={activeVersionId}
        activeVersionName={activeVersionName}
      />
    )}
    {preset.header.rightClusterOrder.map((item) => (
      item === 'search' ? (
        <Fragment>
          <button
            type="button"
            data-search-trigger
            aria-label="Search documentation"
            title="Search documentation (⌘K)"
            class="group flex items-center gap-2 pl-3 pr-1.5 py-1.5 rounded-lg bg-foreground/5 hover:bg-foreground/10 text-muted-foreground hover:text-foreground transition-colors text-sm min-w-[180px] cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0">
              <circle cx="11" cy="11" r="8" />
              <path d="m21 21-4.3-4.3" />
            </svg>
            <span class="flex-1 text-left">Search...</span>
            <kbd class="inline-flex items-center justify-center text-[11px] font-medium opacity-70 px-1.5 py-0.5 rounded border border-foreground/15 transition-colors font-sans">⌘K</kbd>
          </button>
          {assistantEnabled && (
            <button
              type="button"
              data-ask-ai
              aria-label="Ask AI (⌥I)"
              title="Ask AI (⌥I)"
              class="group flex items-center gap-2 pl-3 pr-1.5 py-1.5 rounded-lg bg-foreground/5 hover:bg-foreground/10 text-foreground transition-colors text-sm cursor-pointer"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 text-primary">
                <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z" />
                <path d="M5 3v4" />
                <path d="M3 5h4" />
                <path d="M19 17v4" />
                <path d="M17 19h4" />
              </svg>
              <span>Ask AI</span>
              <kbd class="inline-flex items-center justify-center text-[11px] font-medium opacity-70 px-1.5 py-0.5 rounded border border-foreground/15 transition-colors font-sans">⌥I</kbd>
            </button>
          )}
        </Fragment>
      ) : item === 'links' ? (
        <Fragment>
          {navbarLinks.map((link) => {
            const style = link.style ?? 'default'
            const external = isExternal(link.url)
            const iconSvg = navbarIconSvg(link.icon)
            const target = external ? '_blank' : undefined
            const rel = external ? 'noopener noreferrer' : undefined
            const baseClasses =
              'flex items-center gap-2 px-3 py-1.5 rounded-lg text-sm font-medium transition-colors no-underline'
            let variantStyle: string | undefined
            let variantClasses = ''
            if (style === 'primary') {
              variantStyle = 'background-color: var(--primary); color: var(--primary-foreground);'
              variantClasses = 'hover:opacity-90'
            } else if (style === 'subtle') {
              variantStyle =
                'background-color: color-mix(in srgb, var(--primary) 15%, transparent); ' +
                'color: var(--primary); ' +
                'border: 1px solid color-mix(in srgb, var(--primary) 40%, transparent);'
              variantClasses = 'hover:bg-primary/25'
            } else {
              variantClasses = 'text-foreground/70 hover:text-foreground hover:bg-muted'
            }
            const iconSlot = iconSvg
              ? `<span class="inline-flex items-center justify-center" style="width:18px;height:18px">${iconSvg}</span>`
              : ''
            return (
              <a
                href={link.url}
                target={target}
                rel={rel}
                class:list={[baseClasses, variantClasses]}
                style={variantStyle}
              >
                {iconSvg && <Fragment set:html={iconSlot} />}
                {link.label && <span>{link.label}</span>}
              </a>
            )
          })}
        </Fragment>
      ) : item === 'theme' && hasBothModes !== false ? (
        <button
          type="button"
          data-theme-toggle
          aria-label="Toggle theme"
          title="Toggle light/dark mode"
          class="grid place-items-center w-8 h-8 rounded-lg text-foreground/70 hover:text-foreground hover:bg-muted transition-colors cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="theme-icon-sun" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2" />
            <path d="M12 20v2" />
            <path d="m4.93 4.93 1.41 1.41" />
            <path d="m17.66 17.66 1.41 1.41" />
            <path d="M2 12h2" />
            <path d="M20 12h2" />
            <path d="m6.34 17.66-1.41 1.41" />
            <path d="m19.07 4.93-1.41 1.41" />
          </svg>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="theme-icon-moon" aria-hidden="true">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
          </svg>
        </button>
      ) : null
    ))}
  </div>

  {/* Mobile right cluster — icon-only search + Ask AI sit directly
      in the navbar, the rest (configured CTAs + theme toggle)
      collapse into the kebab dropdown to the right. */}
  <div class="lg:hidden flex items-center gap-1">
    <button
      type="button"
      data-search-trigger
      aria-label="Search documentation"
      title="Search documentation (⌘K)"
      class="grid place-items-center w-9 h-9 rounded-lg text-foreground/70 hover:text-foreground hover:bg-foreground/8 transition-colors cursor-pointer"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8" />
        <path d="m21 21-4.3-4.3" />
      </svg>
    </button>
    {assistantEnabled && (
      <button
        type="button"
        data-ask-ai
        aria-label="Ask AI"
        title="Ask AI (⌥I)"
        class="grid place-items-center w-9 h-9 rounded-lg text-foreground hover:bg-foreground/8 transition-colors cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-primary">
          <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z" />
          <path d="M5 3v4" />
          <path d="M3 5h4" />
          <path d="M19 17v4" />
          <path d="M17 19h4" />
        </svg>
      </button>
    )}
    <div class="relative" data-cta-menu>
      <button
        type="button"
        data-cta-menu-toggle
        aria-label="Menu"
        title="Menu"
        class="grid place-items-center w-9 h-9 rounded-lg text-foreground/70 hover:text-foreground hover:bg-foreground/8 transition-colors cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="5" r="1.5"/>
          <circle cx="12" cy="12" r="1.5"/>
          <circle cx="12" cy="19" r="1.5"/>
        </svg>
      </button>
      <div
        class="hidden absolute right-0 top-full mt-2 w-72 max-w-[calc(100vw-2rem)] flex-col gap-1 p-2 rounded-lg border bg-background z-30"
        style="border-color: var(--chrome-border); box-shadow: 0 12px 32px color-mix(in srgb, var(--foreground) 16%, transparent)"
        data-cta-menu-content
      >
        <RightClusterItems
          items={["links"]}
          navbarLinks={navbarLinks}
          hasBothModes={hasBothModes}
          assistantEnabled={assistantEnabled}
          variant="stacked"
        />
      </div>
    </div>
  </div>
  </div>
</div>
</header>

{/* Subbar — always rendered on mobile (it carries the hamburger that
    opens the sidebar drawer). On desktop, only visible when the
    preset puts sections there (Mist, Slate). For Pearl/Onyx/Jade the
    subbar collapses on desktop via `lg:hidden`. */}
<div
  class:list={[
    'border-b shrink-0 text-foreground',
    preset.header.sectionsPlacement === 'subbar' ? '' : 'lg:hidden',
  ]}
  style="border-bottom-color: var(--chrome-border); font-family: inherit"
>
  <div
    class:list={[
      'subbar-row flex items-stretch h-11 px-4 lg:px-6',
      preset.arrangement === 'centered' ? 'max-w-[1440px] mx-auto' : '',
    ]}
  >
    {/* Hamburger — mobile only, pinned to the left of the subbar.
        Toggles the sidebar drawer. Uses `data-sidebar-toggle` so the
        shared handler in sidebar-drawer.js picks it up. */}
    <button
      type="button"
      data-sidebar-toggle
      aria-label="Toggle sidebar"
      title="Toggle sidebar"
      class="lg:hidden grid place-items-center w-9 self-center mr-2 rounded-lg text-foreground/70 hover:text-foreground hover:bg-foreground/8 transition-colors cursor-pointer"
      style="height: 36px"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="4" x2="20" y1="6" y2="6" />
        <line x1="4" x2="20" y1="12" y2="12" />
        <line x1="4" x2="20" y1="18" y2="18" />
      </svg>
    </button>
    {/* Mobile: breadcrumb of the current page. Desktop (when subbar
        is enabled by preset): section tabs. The two are mutually
        exclusive — lg:hidden swaps which is visible. */}
    {breadcrumb.length > 0 && (
      <div class="lg:hidden flex items-center self-center text-[13px] text-foreground/70 truncate min-w-0">
        {breadcrumb.map((title, i) => (
          <Fragment>
            {i > 0 && (
              <span class="px-1.5 opacity-50" aria-hidden="true">›</span>
            )}
            <span
              class:list={[
                'truncate',
                i === breadcrumb.length - 1 ? 'text-foreground font-medium' : '',
              ]}
            >
              {title}
            </span>
          </Fragment>
        ))}
      </div>
    )}
    {navItems.length > 0 && (
      <nav class="hidden lg:flex items-stretch gap-1 whitespace-nowrap">
        {navItems.map((item) => {
          const isActive = item.id === activeId
          const iconHtml = sectionIconHtml(item.icon, item.title)
          return (
            <a
              href={item.href}
              class:list={[
                'relative flex items-center text-[13px] font-medium px-3 first:pl-0 gap-1.5 transition-colors no-underline',
                isActive
                  ? 'text-primary'
                  : 'text-foreground/70 hover:text-foreground',
              ]}
            >
              {iconHtml && (
                <span
                  class="inline-flex items-center justify-center shrink-0 opacity-90"
                  style="width:16px;height:16px"
                  set:html={iconHtml}
                />
              )}
              <span>{item.title}</span>
              {isActive && (
                <span
                  class="absolute inset-x-0 h-0.5 bg-primary"
                  style="bottom:-1px"
                />
              )}
            </a>
          )
        })}
      </nav>
    )}
  </div>
</div>

{/* Mobile sidebar backdrop — opacity-driven via the outer wrapper's
    `data-sidebar-open` attribute, tap-to-close via the toggle JS. */}
<div class="sidebar-backdrop" data-sidebar-toggle aria-hidden="true"></div>

{/* Close affordance for the mobile drawer — sits OUTSIDE the sidebar
    in the gutter between the drawer's right edge and the viewport
    right. Only renders/visible while the drawer is open on mobile. */}
<button
  type="button"
  class="sidebar-drawer-close"
  data-sidebar-toggle
  aria-label="Close sidebar"
  title="Close sidebar"
>
  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M18 6L6 18"/>
    <path d="M6 6l12 12"/>
  </svg>
</button>
