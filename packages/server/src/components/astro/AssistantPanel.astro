---
/**
 * AI assistant side panel.
 *
 * Always present in the DOM, hidden off-screen via transform until
 * the user clicks [data-ask-ai] in the navbar. Wiring lives in
 * `/assistant-panel.js`, which POSTs questions to `/api/ask`
 * (Worker → content-runtime s2s). This file is the shell only
 * (header + message list scaffold + input).
 */
interface Props {
  /** The version the visitor is currently reading. Sent with every
   *  question so RAG search stays pinned to this version's content
   *  instead of searching across every version of the doc combined. */
  activeVersionId?: string
}
const { activeVersionId } = Astro.props
---

<aside
  class="assistant-panel"
  data-assistant-panel
  data-assistant-version-id={activeVersionId}
  aria-label="AI Assistant"
  aria-hidden="true"
  inert
  role="dialog"
>
  <header class="assistant-panel__header">
    <div class="assistant-panel__title">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="assistant-panel__sparkles"
        aria-hidden="true"
      >
        <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
        <path d="M5 3v4"/>
        <path d="M3 5h4"/>
        <path d="M19 17v4"/>
        <path d="M17 19h4"/>
      </svg>
      <span>Assistant</span>
    </div>

    <div class="assistant-panel__actions">
      <button
        type="button"
        class="assistant-panel__action"
        data-assistant-expand
        aria-label="Expand"
        title="Expand"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 3h6v6"/>
          <path d="M9 21H3v-6"/>
          <path d="M21 3l-7 7"/>
          <path d="M3 21l7-7"/>
        </svg>
      </button>
      <button
        type="button"
        class="assistant-panel__action"
        data-assistant-clear
        aria-label="Clear conversation"
        title="Clear conversation"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 6h18"/>
          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/>
          <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
        </svg>
      </button>
      <button
        type="button"
        class="assistant-panel__action"
        data-assistant-close
        aria-label="Close"
        title="Close"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6L6 18"/>
          <path d="M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </header>

  <div class="assistant-panel__messages" data-assistant-messages>
    <div class="assistant-panel__empty">
      <p>Ask anything about the docs.</p>
      <p class="assistant-panel__hint">Press <kbd>⌥I</kbd> to toggle this panel.</p>
    </div>
  </div>

  <form class="assistant-panel__input" data-assistant-form>
    <div class="assistant-panel__input-row">
      <textarea
        class="assistant-panel__textarea"
        placeholder="Ask a question..."
        rows="1"
        data-assistant-textarea
      ></textarea>
      <button
        type="submit"
        class="assistant-panel__send"
        aria-label="Send"
        title="Send"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 19V5"/>
          <path d="m5 12 7-7 7 7"/>
        </svg>
      </button>
    </div>
  </form>
</aside>

<style>
  .assistant-panel {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(420px, 95vw);
    background: var(--background);
    border-left: 1px solid var(--chrome-border);
    display: flex;
    flex-direction: column;
    z-index: 50;
    transform: translateX(100%);
    transition: transform 220ms cubic-bezier(0.25, 0.1, 0.25, 1);
    color: var(--foreground);
    font-family: inherit;
  }
  .assistant-panel[data-open="true"] {
    transform: translateX(0);
  }

  /* Expanded state — wider for serious reading. */
  .assistant-panel[data-expanded="true"] {
    width: min(720px, 95vw);
  }

  /* Mobile + tablet: bottom-sheet layout — slides up from the bottom,
     leaves the top ~15% of the viewport visible so the user can swipe
     or tap down to dismiss without feeling trapped. Border + radius
     on top give it the "sheet over content" feel. Mirrors the
     hamburger/sidebar boundary so the whole UI behaves consistently
     up to 1024px. */
  @media (max-width: 1023px) {
    .assistant-panel {
      top: auto;
      left: 0;
      right: 0;
      bottom: 0;
      width: 100%;
      height: 85vh;
      max-height: 85vh;
      border-left: none;
      border-top: 1px solid var(--chrome-border);
      border-top-left-radius: 16px;
      border-top-right-radius: 16px;
      box-shadow: 0 -8px 32px color-mix(in srgb, var(--foreground) 18%, transparent);
      transform: translateY(100%);
    }
    .assistant-panel[data-open="true"] {
      transform: translateY(0);
    }
    .assistant-panel[data-expanded="true"] {
      width: 100%;
      height: 95vh;
      max-height: 95vh;
    }
    /* iOS Safari auto-zooms when a focused field is < 16px. Bump to 16px
       on mobile so tapping the composer doesn't zoom the page. */
    .assistant-panel__textarea {
      font-size: 16px;
    }
  }

  .assistant-panel__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-bottom: 1px solid var(--chrome-border);
    flex-shrink: 0;
  }
  .assistant-panel__title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
  }
  .assistant-panel__sparkles { color: var(--primary); }
  .assistant-panel__actions {
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .assistant-panel__action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: none;
    border-radius: var(--radius-md);
    background: transparent;
    color: color-mix(in srgb, var(--foreground) 65%, var(--background) 35%);
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
  }
  .assistant-panel__action:hover {
    background: color-mix(in srgb, var(--foreground) 8%, transparent);
    color: var(--foreground);
  }

  .assistant-panel__messages {
    flex: 1;
    overflow-y: auto;
    padding: 18px 18px 24px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    font-size: 13.5px;
    line-height: 1.55;
    letter-spacing: 0.005em;
  }

  .assistant-panel__empty {
    margin: auto 0;
    text-align: center;
    color: color-mix(in srgb, var(--foreground) 55%, var(--background) 45%);
    font-size: 14px;
  }

  /* Message styles live in the `<style is:global>` block at the
     bottom of the file — they target nodes created dynamically by
     `assistant-panel.js`, which don't inherit Astro's scoped data
     attribute. Scoped selectors would simply not match. */
  .assistant-panel__hint {
    margin-top: 8px;
    font-size: 12px;
    opacity: 0.75;
  }
  .assistant-panel__hint kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 2px 6px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--foreground) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--foreground) 12%, transparent);
    font-family: inherit;
    font-size: 11px;
  }

  .assistant-panel__input {
    flex-shrink: 0;
    border-top: 1px solid var(--chrome-border);
    padding: 12px;
    background: color-mix(in srgb, var(--foreground) 2%, transparent);
  }
  .assistant-panel__input-row {
    position: relative;
    border: 1px solid color-mix(in srgb, var(--primary) 50%, transparent);
    border-radius: var(--radius-lg);
    padding: 10px 48px 10px 12px; /* room for the send button on the right */
    background: var(--background);
    transition: border-color 0.15s;
  }
  .assistant-panel__input-row:focus-within {
    border-color: var(--primary);
  }
  .assistant-panel__textarea {
    width: 100%;
    border: none;
    background: transparent;
    color: var(--foreground);
    font-family: inherit;
    font-size: 14px;
    line-height: 1.4;
    resize: none;
    max-height: 200px;
    outline: none;
  }
  .assistant-panel__textarea::placeholder {
    color: color-mix(in srgb, var(--foreground) 45%, var(--background) 55%);
  }
  .assistant-panel__send {
    position: absolute;
    right: 8px;
    bottom: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: none;
    border-radius: var(--radius-md);
    background: var(--primary);
    color: var(--primary-foreground);
    cursor: pointer;
    transition: opacity 0.15s, transform 0.15s;
  }
  .assistant-panel__send:hover { opacity: 0.9; }
  .assistant-panel__send:active { transform: scale(0.96); }

  /* When the page-level body has the panel open, optionally show a
     subtle backdrop. Skipped for now — Mintlify's flow doesn't dim
     the page, you can still read while chatting. */
</style>

<style is:global>
  /* Push behavior — only for `full-width` arrangement (Pearl) AND only
     on desktop (lg+ = ≥1024px). On mobile + tablet the panel slides
     from the bottom and overlays, so there's nothing to push. */
  @media (min-width: 1024px) {
    body:has(.assistant-panel[data-open="true"]) [data-arrangement="full-width"] {
      padding-right: min(420px, 95vw);
      transition: padding-right 220ms cubic-bezier(0.25, 0.1, 0.25, 1);
    }
    body:has(.assistant-panel[data-open="true"][data-expanded="true"]) [data-arrangement="full-width"] {
      padding-right: min(720px, 95vw);
    }
    /* Match the wrapper's resting state to the panel's transition so
       opening and closing both animate smoothly. */
    [data-arrangement="full-width"] {
      transition: padding-right 220ms cubic-bezier(0.25, 0.1, 0.25, 1);
    }
  }

  /* Free up reading width while the user is chatting — hide the TOC
     entirely when the panel is open. The article's max-w-4xl keeps it
     readable in the freed space. */
  body:has(.assistant-panel[data-open="true"]) .toc-aside {
    display: none;
  }

  /* The floating chat input also collapses while the panel is open —
     two entry points to the same conversation surface would be
     redundant once the panel is on screen. Same slide-down + fade
     transition the floating already uses for its visibility state. */
  body:has(.assistant-panel[data-open="true"]) .assistant-floating {
    transform: translateX(-50%) translateY(20px);
    opacity: 0;
    pointer-events: none;
  }

  /* --- Chat message bubbles ---
     User: right-aligned pill chip with a soft muted fill.
     AI: plain prose, stretches full width.
     Copy chip: subtle outlined button with hover + copied state. */
  .assistant-msg {
    font-size: 13.5px;
    line-height: 1.55;
  }
  .assistant-msg--user {
    align-self: flex-end;
    max-width: 80%;
    padding: 7px 14px;
    background: color-mix(in srgb, var(--foreground) 7%, transparent);
    color: var(--foreground);
    border-radius: 18px;
    border-bottom-right-radius: 6px;
    word-wrap: break-word;
    overflow-wrap: anywhere;
  }
  .assistant-msg--ai {
    align-self: stretch;
    color: var(--foreground);
  }
  .assistant-msg__body { color: var(--foreground); }
  .assistant-msg__body strong { font-weight: 600; }
  .assistant-msg__body em { font-style: italic; }
  .assistant-msg__body p { margin: 0 0 10px; }
  .assistant-msg__body > :first-child { margin-top: 0; }
  .assistant-msg__body > :last-child { margin-bottom: 0; }
  .assistant-msg__body h1,
  .assistant-msg__body h2,
  .assistant-msg__body h3,
  .assistant-msg__body h4 {
    font-weight: 600;
    line-height: 1.3;
    margin: 16px 0 8px;
  }
  .assistant-msg__body h1 { font-size: 17px; }
  .assistant-msg__body h2 { font-size: 15.5px; }
  .assistant-msg__body h3,
  .assistant-msg__body h4 { font-size: 14px; }
  .assistant-msg__body ul,
  .assistant-msg__body ol {
    margin: 0 0 10px;
    padding-left: 20px;
  }
  .assistant-msg__body li { margin: 3px 0; }
  .assistant-msg__body a {
    color: var(--primary, currentColor);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .assistant-msg__body code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.88em;
    padding: 1px 5px;
    border-radius: 5px;
    background: color-mix(in srgb, var(--foreground) 8%, transparent);
  }
  .assistant-msg__body pre {
    margin: 0 0 10px;
    padding: 12px 14px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--foreground) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--foreground) 10%, transparent);
    overflow-x: auto;
  }
  .assistant-msg__body pre code {
    padding: 0;
    background: transparent;
    font-size: 12.5px;
    line-height: 1.5;
  }
  .assistant-msg__body hr {
    border: 0;
    border-top: 1px solid color-mix(in srgb, var(--foreground) 12%, transparent);
    margin: 14px 0;
  }

  /* Pending-answer indicator — three dots bouncing in sequence, shown
     in place of the AI bubble's body while a question is in flight.
     Shared by the side panel and the KB landing hero chat. */
  .assistant-thinking {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 0;
  }
  .thinking-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--foreground) 55%, transparent);
    animation: assistant-thinking-bounce 1.2s ease-in-out infinite;
  }
  .thinking-dot:nth-child(2) { animation-delay: 0.15s; }
  .thinking-dot:nth-child(3) { animation-delay: 0.3s; }
  @keyframes assistant-thinking-bounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
    30% { transform: translateY(-4px); opacity: 1; }
  }

  .assistant-msg__actions {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
  }
  .assistant-msg__action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 26px;
    padding: 0 10px;
    border: 1px solid transparent;
    border-radius: 8px;
    background: transparent;
    color: color-mix(in srgb, var(--foreground) 55%, var(--background) 45%);
    font: inherit;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color 0.15s,
      border-color 0.15s,
      color 0.15s;
  }
  .assistant-msg__action svg { width: 13px; height: 13px; }
  .assistant-msg__action-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .assistant-msg__action-label { line-height: 1; }
  .assistant-msg__action:hover {
    background: color-mix(in srgb, var(--foreground) 7%, transparent);
    border-color: color-mix(in srgb, var(--foreground) 10%, transparent);
    color: var(--foreground);
  }
  .assistant-msg__action.is-copied {
    color: var(--primary);
    border-color: color-mix(in srgb, var(--primary) 35%, transparent);
    background: color-mix(in srgb, var(--primary) 8%, transparent);
  }

  /* Answer "Sources" chips — same treatment as the KB landing's
     `.kb-sources` (see index.css), scoped here since this panel renders
     on every page, not just the KB home. */
  .assistant-sources {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid color-mix(in srgb, var(--foreground) 10%, transparent);
  }
  .assistant-sources__label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--foreground) 50%, var(--background) 50%);
  }
  .assistant-source {
    font-size: 12px;
    padding: 4px 10px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--foreground) 7%, transparent);
    border: 1px solid color-mix(in srgb, var(--foreground) 12%, transparent);
    color: color-mix(in srgb, var(--foreground) 75%, var(--background) 25%);
    text-decoration: none;
    transition: color 0.15s, border-color 0.15s;
  }
  a.assistant-source:hover {
    color: var(--foreground);
    border-color: color-mix(in srgb, var(--foreground) 22%, transparent);
  }
</style>
